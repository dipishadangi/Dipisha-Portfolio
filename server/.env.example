# Copy this file to server/.env and fill it in. Never commit server/.env.

# Postgres connection string.
# Supabase: Project Settings -> Database -> Connection string -> URI
# (or use Neon, Railway, or a local Postgres.)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Signs the admin login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where the API listens.
PORT=4000

# Which front end may call the API. Comma-separated for more than one.
CLIENT_ORIGIN=http://localhost:5173

# How many contact-form messages one IP may send per hour.
CONTACT_RATE_LIMIT=5

# --- Image storage (Supabase Storage) ------------------------------------
# Supabase dashboard -> Project Settings -> Data API for the URL,
# and Project Settings -> API Keys for the service_role key.
#
# The service_role key bypasses every security rule. It stays on the server
# and must never be committed or sent to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The storage bucket to upload into. It must exist and be public.
SUPABASE_BUCKET=DIPISHA
