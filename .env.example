# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the two values.
# Supabase dashboard -> Project Settings -> API
#
# Both keys are safe to expose in the browser: the anon key can only do what
# the row-level security policies in supabase/schema.sql allow.
# NEVER put the service_role key in here — it bypasses every policy.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
