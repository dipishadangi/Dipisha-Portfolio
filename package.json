{
  "name": "dipisha-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio for Dipisha Chhetri — React front end, Express API, Postgres.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,magenta \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "db:setup": "npm --prefix server run db:setup",
    "db:seed": "npm --prefix server run db:seed",
    "create:admin": "npm --prefix server run create:admin",
    "smoke": "npm --prefix server run smoke",
    "migrate:storage": "npm --prefix server run migrate:storage",
    "lint": "npm --prefix client run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
